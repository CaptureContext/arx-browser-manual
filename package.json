{
  "name": "arx-manual-frontend-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0-rc.8",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @capturecontext/arx-manual dev",
    "generate": "pnpm --filter @capturecontext/arx-manual generate",
    "preview": "pnpm --filter @capturecontext/arx-manual preview",
    "build": "pnpm generate",
    "typecheck": "pnpm --filter @capturecontext/arx-manual typecheck",
    "recordings": "node scripts/list-recordings.mjs"
  },
  "devDependencies": {
    "railway": "^3.17.0"
  }
}
